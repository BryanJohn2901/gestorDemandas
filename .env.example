# URL e chaves do projeto Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Secret key — NUNCA exponha no client. Usada apenas em Server Actions
# para criar/editar colaboradores via Supabase Admin API.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Asaas (pagamento). "sandbox" pra testar sem dinheiro real, "production"
# só quando for cobrar de verdade. Chave em Integrações > API Key no painel
# do Asaas (sandbox e produção têm chaves diferentes).
ASAAS_ENV=sandbox
ASAAS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token que você escolhe ao cadastrar o webhook no painel do Asaas
# (Integrações > Webhooks) — vem de volta no header "asaas-access-token"
# de toda chamada, é como confirmamos que quem chamou é o Asaas mesmo.
ASAAS_WEBHOOK_TOKEN=escolha-uma-string-aleatoria-longa

# Valor do plano único, em reais.
ASAAS_PLANO_VALOR=19.90
